{
  "dashboard": {
    "title": "Qalitrack Platform Overview",
    "tags": ["qalitrack", "overview"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Services Status",
        "type": "stat",
        "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "up{namespace=\"qalitrack-prod\", app_kubernetes_io_part_of=\"qalitrack\"}",
            "legendFormat": "{{app_kubernetes_io_name}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "mappings": [
              {"type": "value", "value": "0", "text": "Down"},
              {"type": "value", "value": "1", "text": "Up"}
            ],
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Total Requests/sec",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{namespace=\"qalitrack-prod\"}[5m])) by (app_kubernetes_io_name)",
            "legendFormat": "{{app_kubernetes_io_name}}"
          }
        ]
      },
      {
        "id": 3,
        "title": "Error Rate %",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{namespace=\"qalitrack-prod\",status=~\"5..\"}[5m])) by (app_kubernetes_io_name) / sum(rate(http_requests_total{namespace=\"qalitrack-prod\"}[5m])) by (app_kubernetes_io_name) * 100",
            "legendFormat": "{{app_kubernetes_io_name}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          }
        }
      },
      {
        "id": 4,
        "title": "Pod CPU Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"qalitrack-prod\", container!=\"\"}[5m])) by (pod)",
            "legendFormat": "{{pod}}"
          }
        ]
      },
      {
        "id": 5,
        "title": "Pod Memory Usage",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {
            "expr": "sum(container_memory_usage_bytes{namespace=\"qalitrack-prod\", container!=\"\"}) by (pod)",
            "legendFormat": "{{pod}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          }
        }
      },
      {
        "id": 6,
        "title": "Database Connections",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "pg_stat_activity_count{namespace=\"qalitrack-prod\"}",
            "legendFormat": "{{datname}}"
          }
        ]
      },
      {
        "id": 7,
        "title": "Redis Hit Rate %",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "targets": [
          {
            "expr": "rate(redis_keyspace_hits_total{namespace=\"qalitrack-prod\"}[5m]) / (rate(redis_keyspace_hits_total{namespace=\"qalitrack-prod\"}[5m]) + rate(redis_keyspace_misses_total{namespace=\"qalitrack-prod\"}[5m])) * 100",
            "legendFormat": "Hit Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          }
        }
      }
    ],
    "refresh": "30s",
    "schemaVersion": 36,
    "style": "dark",
    "time": {"from": "now-1h", "to": "now"},
    "timepicker": {},
    "version": 1
  }
}
