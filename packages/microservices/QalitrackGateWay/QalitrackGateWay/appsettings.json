{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:80",
        "Protocols": "Http1"
      }
    },
    "EndpointDefaults": {
      "Protocols": "Http1"
    }
  },
  "HttpsRedirection": {
    "HttpsPort": null
  },
  "ForwardedHeaders": {
    "ForwardedHeaders": "All"
  },
  "Authentication": {
    "RequireHttpsMetadata": false
  },
  "JwtBearer": {
    "RequireHttpsMetadata": false
  },

  "ReverseProxy": {
    "Routes": {
      "user-service-swagger": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/swagger/{**catch-all}",
          "Hosts": ["qalitrack.cseco.co.ke"]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ],
        "Order": 1
      },

      "user-service-health": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/health/{**catch-all}",
          "Hosts": ["qalitrack.cseco.co.ke"]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ],
        "Order": 2
      },

      "backup-service-routes": {
        "ClusterId": "backup-service-cluster",
        "Match": {
          "Path": "/api/Backup/{**catch-all}",
          "Hosts": ["qalitrack.cseco.co.ke"]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ],
        "Order": 10
      },

      "microservice-routes": {
        "ClusterId": "backup-service-cluster",
        "Match": {
          "Path": "/api/Microservice/{**catch-all}",
          "Hosts": ["qalitrack.cseco.co.ke"]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ],
        "Order": 11
      },

      "user-service-api": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/{**catch-all}",
          "Hosts": ["qalitrack.cseco.co.ke"]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ],
        "Order": 50
      },

      "masterdata-service-swagger": {
        "ClusterId": "masterdata-service-cluster",
        "Match": {
          "Path": "/api/MasterData/swagger/{**catch-all}",
          "Hosts": ["qalitrack.cseco.co.ke"]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/MasterData" }
        ],
        "Order": 100
      },

      "masterdata-service-health": {
        "ClusterId": "masterdata-service-cluster",
        "Match": {
          "Path": "/api/MasterData/health/{**catch-all}",
          "Hosts": ["qalitrack.cseco.co.ke"]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/MasterData" }
        ],
        "Order": 101
      },

      "masterdata-service-api": {
        "ClusterId": "masterdata-service-cluster",
        "Match": {
          "Path": "/api/MasterData/{**catch-all}",
          "Hosts": ["qalitrack.cseco.co.ke"]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/MasterData" }
        ],
        "Order": 110
      },

      "transaction-service-swagger": {
        "ClusterId": "transaction-service-cluster",
        "Match": {
          "Path": "/api/Transaction/swagger/{**catch-all}",
          "Hosts": ["qalitrack.cseco.co.ke"]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/Transaction" }
        ],
        "Order": 200
      },

      "transaction-service-health": {
        "ClusterId": "transaction-service-cluster",
        "Match": {
          "Path": "/api/Transaction/health/{**catch-all}",
          "Hosts": ["qalitrack.cseco.co.ke"]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/Transaction" }
        ],
        "Order": 201
      },

      "transaction-service-api": {
        "ClusterId": "transaction-service-cluster",
        "Match": {
          "Path": "/api/Transaction/{**catch-all}",
          "Hosts": ["qalitrack.cseco.co.ke"]
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ],
        "Order": 210
      }
    },

    "Clusters": {
      "user-service-cluster": {
        "Destinations": {
          "user-service": {
            "Address": "http://qalitrack-user-service-prod:80"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": false
        }
      },

      "masterdata-service-cluster": {
        "Destinations": {
          "masterdata-service": {
            "Address": "http://qalitrack-masterdata-service-prod:80"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": false
        }
      },

      "backup-service-cluster": {
        "Destinations": {
          "backup-service": {
            "Address": "http://qalitrack-backup-service-prod:80"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": false
        }
      }
    }
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5000",
      "http://localhost:5173",
      "https://qalitrack.cseco.co.ke",
      "https://app.qalitrack.cseco.co.ke"
    ],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"],
    "AllowedHeaders": ["Content-Type", "Authorization", "X-Requested-With", "X-User-Id", "X-User-Email"],
    "AllowCredentials": true,
    "MaxAge": 3600
  }
}