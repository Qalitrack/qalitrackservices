{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "HttpsRedirection": {
    "HttpsPort": null
  },
  "ForwardedHeaders": {
    "ForwardedHeaders": "All",
    "_comment": "KnownProxies/KnownNetworks are OPT-IN. Leave empty for offline installs where this gateway is the edge (no reverse proxy in front) — X-Forwarded-For is then ignored and the real connection IP is used. Only add entries here for deployments that actually sit behind a known reverse proxy (e.g. a cloud install behind an ingress controller).",
    "KnownProxies": [],
    "KnownNetworks": []
  },

  "ReverseProxy": {
    "Routes": {
      "user-service-swagger": {
        "ClusterId": "user-service-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/api/swagger/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ],
        "Order": 1
      },

      "user-service-health": {
        "ClusterId": "user-service-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/api/health/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ],
        "Order": 2
      },

      "user-service-auth": {
        "ClusterId": "user-service-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/api/Auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ],
        "Order": 3
      },

      "backup-service-routes": {
        "ClusterId": "backup-service-cluster",
        "Match": {
          "Path": "/api/Backup/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ],
        "Order": 10
      },

      "microservice-routes": {
        "ClusterId": "backup-service-cluster",
        "Match": {
          "Path": "/api/Microservice/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ],
        "Order": 11
      },

      "user-service-api": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ],
        "Order": 50
      },

      "masterdata-service-swagger": {
        "ClusterId": "masterdata-service-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/api/MasterData/swagger/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/MasterData" }
        ],
        "Order": 10
      },

      "masterdata-service-health": {
        "ClusterId": "masterdata-service-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/api/MasterData/health/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/MasterData" }
        ],
        "Order": 11
      },

      "masterdata-service-api": {
        "ClusterId": "masterdata-service-cluster",
        "Match": {
          "Path": "/api/MasterData/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/MasterData" }
        ],
        "Order": 12
      },

      "transaction-service-swagger": {
        "ClusterId": "transaction-service-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/api/Transaction/swagger/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/Transaction" }
        ],
        "Order": 20
      },

      "transaction-service-health": {
        "ClusterId": "transaction-service-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/api/Transaction/health/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/Transaction" }
        ],
        "Order": 21
      },

      "transaction-service-api": {
        "ClusterId": "transaction-service-cluster",
        "Match": {
          "Path": "/api/Transaction/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/Transaction" }
        ],
        "Order": 22
      },

      "tech-user-service-swagger": {
        "ClusterId": "tech-user-service-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/api/tech/user/swagger/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/tech/user" }
        ],
        "Order": 300
      },

      "tech-user-service-health": {
        "ClusterId": "tech-user-service-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/api/tech/user/health/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/tech/user" }
        ],
        "Order": 301
      },

      "tech-user-service-api": {
        "ClusterId": "tech-user-service-cluster",
        "Match": {
          "Path": "/api/tech/user/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/tech/user" }
        ],
        "Order": 310
      },

      "qtruck-api-health": {
        "ClusterId": "qtruck-api-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/api/qtruck/health/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/qtruck" }
        ],
        "Order": 500
      },

      "qtruck-api": {
        "ClusterId": "qtruck-api-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/api/qtruck/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/qtruck" }
        ],
        "Order": 510
      },

      "qtruck-frontend": {
        "ClusterId": "qtruck-frontend-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/qtruck/{**catch-all}"
        },
        "Order": 600
      }
    },

    "Clusters": {
      "user-service-cluster": {
        "Destinations": {
          "user-service": {
            "Address": "http://user-service-prod:80"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": false
        }
      },

      "masterdata-service-cluster": {
        "Destinations": {
          "masterdata-service": {
            "Address": "http://masterdata-service-prod:80"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": false
        }
      },

      "backup-service-cluster": {
        "Destinations": {
          "backup-service": {
            "Address": "http://backup-service-prod:80"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": false
        }
      },

      "transaction-service-cluster": {
        "Destinations": {
          "transaction-service": {
            "Address": "http://transaction-service-prod:80"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": false
        }
      },

      "tech-user-service-cluster": {
        "Destinations": {
          "tech-user-service": {
            "Address": "http://qalitrack-user-service-prod:80"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": false
        }
      },

      "qtruck-api-cluster": {
        "Destinations": {
          "qtruck-api": {
            "Address": "http://qtruck-api:7007"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": false
        }
      },

      "qtruck-frontend-cluster": {
        "Destinations": {
          "qtruck-frontend": {
            "Address": "http://qtruck-frontend:7008"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": false
        }
      }
    }
  },

  "Cors": {
    "AllowedOrigins": [],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"],
    "AllowedHeaders": ["Content-Type", "Authorization", "X-Requested-With", "X-User-Id", "X-User-Email"],
    "AllowCredentials": false,
    "MaxAge": 3600
  }
}