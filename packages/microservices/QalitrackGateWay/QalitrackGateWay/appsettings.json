{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "HttpsRedirection": {
    "HttpsPort": null
  },
  "ForwardedHeaders": {
    "ForwardedHeaders": "All"
  },

  "ReverseProxy": {
    "Routes": {
      "user-service-swagger": {
        "ClusterId": "user-service-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/api/swagger/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ],
        "Order": 1
      },

      "user-service-health": {
        "ClusterId": "user-service-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/api/health/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ],
        "Order": 2
      },

      "user-service-auth": {
        "ClusterId": "user-service-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/api/Auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ],
        "Order": 3
      },

      "backup-service-routes": {
        "ClusterId": "backup-service-cluster",
        "Match": {
          "Path": "/api/Backup/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ],
        "Order": 10
      },

      "microservice-routes": {
        "ClusterId": "backup-service-cluster",
        "Match": {
          "Path": "/api/Microservice/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ],
        "Order": 11
      },

      "user-service-api": {
        "ClusterId": "user-service-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ],
        "Order": 50
      },

      "masterdata-service-swagger": {
        "ClusterId": "masterdata-service-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/api/MasterData/swagger/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/MasterData" }
        ],
        "Order": 100
      },

      "masterdata-service-health": {
        "ClusterId": "masterdata-service-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/api/MasterData/health/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/MasterData" }
        ],
        "Order": 101
      },

      "masterdata-service-api": {
        "ClusterId": "masterdata-service-cluster",
        "Match": {
          "Path": "/api/MasterData/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/MasterData" }
        ],
        "Order": 110
      },

      "transaction-service-swagger": {
        "ClusterId": "transaction-service-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/api/Transaction/swagger/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/Transaction" }
        ],
        "Order": 200
      },

      "transaction-service-health": {
        "ClusterId": "transaction-service-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/api/Transaction/health/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/Transaction" }
        ],
        "Order": 201
      },

      "transaction-service-api": {
        "ClusterId": "transaction-service-cluster",
        "Match": {
          "Path": "/api/Transaction/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api/Transaction" }
        ],
        "Order": 210
      },

      "tech-user-service-swagger": {
        "ClusterId": "tech-user-service-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/tech/user/swagger/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/tech/user" }
        ],
        "Order": 300
      },

      "tech-user-service-health": {
        "ClusterId": "tech-user-service-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/tech/user/health/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/tech/user" }
        ],
        "Order": 301
      },

      "tech-user-service-api": {
        "ClusterId": "tech-user-service-cluster",
        "Match": {
          "Path": "/tech/user/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/tech/user" }
        ],
        "Order": 310
      },

      "tech-technician-service-swagger": {
        "ClusterId": "tech-technician-service-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/tech/technician/swagger/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/tech/technician" }
        ],
        "Order": 400
      },

      "tech-technician-service-health": {
        "ClusterId": "tech-technician-service-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "/tech/technician/health/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/tech/technician" }
        ],
        "Order": 401
      },

      "tech-technician-service-api": {
        "ClusterId": "tech-technician-service-cluster",
        "Match": {
          "Path": "/tech/technician/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/tech/technician" }
        ],
        "Order": 410
      }
    },

    "Clusters": {
      "user-service-cluster": {
        "Destinations": {
          "user-service": {
            "Address": "http://user-service-prod:80"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": false
        }
      },

      "masterdata-service-cluster": {
        "Destinations": {
          "masterdata-service": {
            "Address": "http://masterdata-service-prod:80"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": false
        }
      },

      "backup-service-cluster": {
        "Destinations": {
          "backup-service": {
            "Address": "http://backup-service-prod:80"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": false
        }
      },

      "transaction-service-cluster": {
        "Destinations": {
          "transaction-service": {
            "Address": "http://transaction-service-prod:80"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": false
        }
      },

      "tech-user-service-cluster": {
        "Destinations": {
          "tech-user-service": {
            "Address": "http://qalitrack-user-service-prod:80"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": false
        }
      },

      "tech-technician-service-cluster": {
        "Destinations": {
          "tech-technician-service": {
            "Address": "http://qalitrack-technician-service-prod:80"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": false
        }
      }
    }
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5000",
      "http://localhost:5173",
      "https://qalibrated.co.ke",
      "https://www.qalibrated.co.ke",
      "https://api.qalibrated.co.ke",
      "https://app.qalibrated.co.ke"
    ],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"],
    "AllowedHeaders": ["Content-Type", "Authorization", "X-Requested-With", "X-User-Id", "X-User-Email"],
    "AllowCredentials": true,
    "MaxAge": 3600
  }
}