{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=archive.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ArchiveService": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/archive-service-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "AllowedHosts": "*",
  "ArchiveService": {
    "DefaultCompressionType": "GZIP",
    "DefaultStorageTier": "HOT",
    "MaxArchiveSize": 10737418240,
    "RetentionCheckInterval": "24:00:00",
    "IndexingEnabled": true,
    "ParallelProcessing": true,
    "MaxConcurrentOperations": 5,
    "BackgroundServiceIntervals": {
      "RetentionPolicyCheck": "01:00:00",
      "ArchiveMaintenance": "06:00:00"
    }
  },
  "Storage": {
    "DefaultProvider": "LOCAL",
    "EncryptionEnabled": true,
    "CompressionEnabled": true,
    "ReplicationEnabled": false,
    "AutoTieringEnabled": true,
    "LocalStorage": {
      "BasePath": "/var/archives",
      "MaxSize": 107374182400
    }
  },
  "Search": {
    "Provider": "ELASTICSEARCH",
    "IndexingEnabled": true,
    "FullTextSearchEnabled": true,
    "FacetedSearchEnabled": true,
    "MaxSearchResults": 1000,
    "SearchTimeout": "00:00:30",
    "ElasticsearchUrl": "http://localhost:9200"
  }
}