@RouteService.Api_HostAddress = https://localhost:7143

# Test Route Service API

###
# Get all routes
GET {{RouteService.Api_HostAddress}}/api/routes
Accept: application/json

###
# Get active routes only
GET {{RouteService.Api_HostAddress}}/api/routes?activeOnly=true
Accept: application/json

###
# Search routes
GET {{RouteService.Api_HostAddress}}/api/routes?search=highway
Accept: application/json

###
# Create a new route
POST {{RouteService.Api_HostAddress}}/api/routes
Content-Type: application/json

{
  "name": "Highway 95 North",
  "code": "HWY95N",
  "description": "Major north-south highway route",
  "origin": "Las Vegas, NV",
  "destination": "Reno, NV",
  "distance": 447.5,
  "estimatedDuration": "06:30:00",
  "maxVehicleWeight": 80000,
  "maxVehicleHeight": 13.5,
  "routeType": "Highway"
}

###
# Get route by ID (replace with actual ID)
GET {{RouteService.Api_HostAddress}}/api/routes/{route-id}
Accept: application/json

###
# Get route by code
GET {{RouteService.Api_HostAddress}}/api/routes/code/HWY95N
Accept: application/json

###
# Get waypoints for a route
GET {{RouteService.Api_HostAddress}}/api/routes/{route-id}/waypoints
Accept: application/json

###
# Add waypoint to route
POST {{RouteService.Api_HostAddress}}/api/routes/{route-id}/waypoints
Content-Type: application/json

{
  "name": "Beatty Rest Area",
  "latitude": 36.9085,
  "longitude": -116.7592,
  "sequence": 1,
  "type": "RestStop",
  "isRequired": false,
  "address": "Highway 95",
  "city": "Beatty",
  "state": "NV",
  "country": "USA"
}

###
# Get restrictions for a route
GET {{RouteService.Api_HostAddress}}/api/routes/{route-id}/restrictions
Accept: application/json

###
# Add restriction to route
POST {{RouteService.Api_HostAddress}}/api/routes/{route-id}/restrictions
Content-Type: application/json

{
  "name": "Weight Restriction - Bridge",
  "description": "Maximum weight limit for bridge crossing",
  "type": "Weight",
  "severity": "High",
  "maxWeight": 75000,
  "enforcementAgency": "Nevada DOT"
}

###
# Get conditions for a route
GET {{RouteService.Api_HostAddress}}/api/routes/{route-id}/conditions?activeOnly=true
Accept: application/json

###
# Report condition for route
POST {{RouteService.Api_HostAddress}}/api/routes/{route-id}/conditions
Content-Type: application/json

{
  "type": "Construction",
  "status": "Warning",
  "description": "Lane closure for maintenance work",
  "severityLevel": 3,
  "location": "Mile marker 150",
  "estimatedDelay": 15,
  "recommendedAction": "Use alternate route or expect delays"
}