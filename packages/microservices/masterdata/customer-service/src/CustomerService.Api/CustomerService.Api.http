@CustomerService.Api_HostAddress = http://localhost:7008

### Health Check
GET {{CustomerService.Api_HostAddress}}/health
Accept: application/json

### Get all customers
GET {{CustomerService.Api_HostAddress}}/api/customers
Accept: application/json

### Create a new customer
POST {{CustomerService.Api_HostAddress}}/api/customers
Content-Type: application/json

{
  "name": "Acme Corporation",
  "taxNumber": "TAX123456",
  "registrationNumber": "REG789012",
  "contactEmail": "contact@acme.com",
  "contactPhone": "+254700123456",
  "billingAddress": "123 Business Street, Nairobi, Kenya",
  "customerType": "Corporate",
  "creditLimit": 100000,
  "notes": "Major client in construction industry",
  "isSupplier": false,
  "isBuyer": true,
  "paymentTermsDays": 30,
  "currency": "KES"
}

### Get customer by ID (replace with actual ID)
GET {{CustomerService.Api_HostAddress}}/api/customers/{customer-id}
Accept: application/json

### Update customer (replace with actual ID)
PUT {{CustomerService.Api_HostAddress}}/api/customers/{customer-id}
Content-Type: application/json

{
  "name": "Acme Corporation Ltd",
  "contactEmail": "info@acme.com",
  "creditLimit": 150000
}

### Activate customer (replace with actual ID)
POST {{CustomerService.Api_HostAddress}}/api/customers/{customer-id}/activate
Content-Type: application/json

### Get customer contacts (replace with actual ID)
GET {{CustomerService.Api_HostAddress}}/api/customers/{customer-id}/contacts
Accept: application/json

### Add contact to customer (replace with actual ID)
POST {{CustomerService.Api_HostAddress}}/api/customers/{customer-id}/contacts
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Doe",
  "email": "john.doe@acme.com",
  "phone": "+254700123456",
  "position": "Procurement Manager",
  "department": "Operations",
  "contactType": "Primary",
  "role": "DecisionMaker",
  "isPrimary": true
}

### Get customer contracts (replace with actual ID)
GET {{CustomerService.Api_HostAddress}}/api/customers/{customer-id}/contracts
Accept: application/json

### Create contract for customer (replace with actual ID)
POST {{CustomerService.Api_HostAddress}}/api/customers/{customer-id}/contracts
Content-Type: application/json

{
  "contractNumber": "CNT-2024-001",
  "title": "Annual Supply Agreement",
  "description": "Annual contract for cement supply",
  "startDate": "2024-01-01T00:00:00Z",
  "endDate": "2024-12-31T23:59:59Z",
  "contractValue": 500000,
  "contractType": "Supply",
  "pricingTerms": "Fixed pricing with quarterly reviews",
  "paymentTerms": "Net 30 days",
  "autoRenew": true,
  "renewalPeriodMonths": 12
}

### Create a new order
POST {{CustomerService.Api_HostAddress}}/api/orders
Content-Type: application/json

{
  "customerId": "{customer-id}",
  "productId": "PROD-001",
  "productName": "Portland Cement",
  "quantity": 100,
  "unitOfMeasure": "MT",
  "unitPrice": 15000,
  "expectedDeliveryDate": "2024-02-15T00:00:00Z",
  "orderType": "Purchase",
  "originLocation": "Bamburi Factory",
  "destinationLocation": "Construction Site A",
  "qualitySpecifications": "Grade 42.5N Portland Cement",
  "customerOrderReference": "PO-2024-001"
}

### Get all orders
GET {{CustomerService.Api_HostAddress}}/api/orders
Accept: application/json

### Get order by ID (replace with actual ID)
GET {{CustomerService.Api_HostAddress}}/api/orders/{order-id}
Accept: application/json

### Update order status (replace with actual ID)
PUT {{CustomerService.Api_HostAddress}}/api/orders/{order-id}/status
Content-Type: application/json

{
  "status": "Confirmed",
  "reason": "Order confirmed by customer",
  "changedBy": "system"
}

### Get customer orders (replace with actual ID)
GET {{CustomerService.Api_HostAddress}}/api/orders/customer/{customer-id}
Accept: application/json

### Get contact by ID (replace with actual ID)
GET {{CustomerService.Api_HostAddress}}/api/contacts/{contact-id}
Accept: application/json

### Log communication with contact (replace with actual ID)
POST {{CustomerService.Api_HostAddress}}/api/contacts/{contact-id}/communications
Content-Type: application/json

{
  "type": "Email",
  "direction": "Outbound",
  "subject": "Order Confirmation Required",
  "content": "Please confirm your order for 100 MT of cement",
  "initiatedBy": "sales@company.com",
  "responseRequired": "Order confirmation",
  "responseDue": "2024-02-10T17:00:00Z"
}

### Get contract by ID (replace with actual ID)
GET {{CustomerService.Api_HostAddress}}/api/contracts/{contract-id}
Accept: application/json

### Renew contract (replace with actual ID)
POST {{CustomerService.Api_HostAddress}}/api/contracts/{contract-id}/renew
Content-Type: application/json

{
  "newEndDate": "2025-12-31T23:59:59Z",
  "newContractValue": 600000,
  "renewalTerms": "5% increase in contract value",
  "renewedBy": "contract.manager@company.com",
  "notes": "Automatic renewal with price adjustment"
}

### Get expiring contracts
GET {{CustomerService.Api_HostAddress}}/api/contracts/expiring?daysAhead=60
Accept: application/json

### Search contracts
GET {{CustomerService.Api_HostAddress}}/api/contracts/search?searchTerm=cement
Accept: application/json
