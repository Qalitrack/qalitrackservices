@DriverService.Api_HostAddress = https://localhost:7157

# Health check
GET {{DriverService.Api_HostAddress}}/swagger

###

# Get all drivers
GET {{DriverService.Api_HostAddress}}/api/drivers
Accept: application/json

###

# Get active drivers
GET {{DriverService.Api_HostAddress}}/api/drivers/active
Accept: application/json

###

# Get drivers by status
GET {{DriverService.Api_HostAddress}}/api/drivers/status/Active
Accept: application/json

###

# Search drivers
GET {{DriverService.Api_HostAddress}}/api/drivers/search?searchTerm=john
Accept: application/json

###

# Get drivers with expiring licenses
GET {{DriverService.Api_HostAddress}}/api/drivers/expiring-licenses?daysAhead=30
Accept: application/json

###

# Create a new driver
POST {{DriverService.Api_HostAddress}}/api/drivers
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Doe",
  "middleName": "Michael",
  "dateOfBirth": "1985-06-15T00:00:00Z",
  "gender": "Male",
  "nationality": "American",
  "phoneNumber": "+1-555-0123",
  "email": "john.doe@example.com",
  "address": "123 Main Street",
  "city": "New York",
  "state": "NY",
  "country": "USA",
  "postalCode": "10001",
  "emergencyContactName": "Jane Doe",
  "emergencyContactPhone": "+1-555-0124",
  "emergencyContactRelationship": "Spouse",
  "employeeId": "EMP001",
  "hireDate": "2023-01-15T00:00:00Z",
  "employmentType": "FullTime",
  "salary": 75000.00,
  "department": "Transportation",
  "supervisor": "Mike Johnson",
  "notes": "Experienced commercial driver"
}

###

# Get driver by ID (replace with actual ID after creating)
GET {{DriverService.Api_HostAddress}}/api/drivers/{driver-id}
Accept: application/json

###

# Get driver by employee ID
GET {{DriverService.Api_HostAddress}}/api/drivers/employee/EMP001
Accept: application/json

###

# Update driver (replace with actual ID)
PUT {{DriverService.Api_HostAddress}}/api/drivers/{driver-id}
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Doe",
  "middleName": "Michael",
  "dateOfBirth": "1985-06-15T00:00:00Z",
  "gender": "Male",
  "nationality": "American",
  "phoneNumber": "+1-555-0123",
  "email": "john.doe@example.com",
  "address": "456 Updated Street",
  "city": "New York",
  "state": "NY",
  "country": "USA",
  "postalCode": "10001",
  "emergencyContactName": "Jane Doe",
  "emergencyContactPhone": "+1-555-0124",
  "emergencyContactRelationship": "Spouse",
  "employeeId": "EMP001",
  "hireDate": "2023-01-15T00:00:00Z",
  "terminationDate": null,
  "employmentType": "FullTime",
  "status": "Active",
  "salary": 80000.00,
  "department": "Transportation",
  "supervisor": "Mike Johnson",
  "notes": "Experienced commercial driver - Updated",
  "profilePhotoUrl": ""
}

###

# Create driver license
POST {{DriverService.Api_HostAddress}}/api/drivers/{driver-id}/license
Content-Type: application/json

{
  "licenseNumber": "DL123456789",
  "issuingCountry": "USA",
  "issuingState": "NY",
  "issueDate": "2020-01-15T00:00:00Z",
  "expiryDate": "2025-01-15T00:00:00Z",
  "status": "Active",
  "categories": "[\"B\", \"CDL_B\"]",
  "restrictions": "",
  "endorsements": "Passenger",
  "lastRenewalDate": "2020-01-15T00:00:00Z",
  "nextRenewalDue": "2025-01-15T00:00:00Z",
  "points": 0,
  "notes": "Clean driving record"
}

###

# Get driver license
GET {{DriverService.Api_HostAddress}}/api/drivers/{driver-id}/license
Accept: application/json

###

# Validate driver license
GET {{DriverService.Api_HostAddress}}/api/drivers/{driver-id}/license/validate
Accept: application/json

###

# Update driver license
PUT {{DriverService.Api_HostAddress}}/api/drivers/{driver-id}/license
Content-Type: application/json

{
  "licenseNumber": "DL123456789",
  "issuingCountry": "USA",
  "issuingState": "NY",
  "issueDate": "2020-01-15T00:00:00Z",
  "expiryDate": "2026-01-15T00:00:00Z",
  "status": "Active",
  "categories": "[\"B\", \"CDL_B\"]",
  "restrictions": "",
  "endorsements": "Passenger",
  "lastRenewalDate": "2024-01-15T00:00:00Z",
  "nextRenewalDue": "2026-01-15T00:00:00Z",
  "points": 0,
  "notes": "License renewed"
}

###

# Get driver violations
GET {{DriverService.Api_HostAddress}}/api/drivers/{driver-id}/violations
Accept: application/json

###

# Record new violation
POST {{DriverService.Api_HostAddress}}/api/drivers/{driver-id}/violations
Content-Type: application/json

{
  "violationType": "Speeding",
  "severity": "Minor",
  "violationDate": "2024-06-01T10:30:00Z",
  "location": "Highway 95, Mile Marker 45",
  "description": "Exceeded speed limit by 10 mph",
  "ticketNumber": "TKT123456",
  "issuingOfficer": "Officer Smith",
  "issuingAgency": "State Police",
  "fineAmount": 150.00,
  "points": 2,
  "courtDate": null,
  "courtLocation": "",
  "isContested": false,
  "affectsEmployment": false,
  "actionTaken": "Warning issued",
  "notes": "First offense"
}

###

# Delete driver (soft delete)
DELETE {{DriverService.Api_HostAddress}}/api/drivers/{driver-id}

###