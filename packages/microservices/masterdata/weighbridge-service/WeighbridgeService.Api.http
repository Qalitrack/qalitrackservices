@WeighbridgeService_HostAddress = https://localhost:7080

### Register a new weighbridge
POST {{WeighbridgeService_HostAddress}}/api/weighbridges
Content-Type: application/json

{
  "name": "Main Loading Bay Weighbridge",
  "code": "WB001",
  "location": "Main Facility - Loading Bay A",
  "maxCapacity": 80000,
  "minCapacity": 100,
  "accuracy": 10,
  "manufacturer": "Avery Weigh-Tronix",
  "model": "WB-80T",
  "serialNumber": "AWT2023001",
  "installationDate": "2023-01-15T00:00:00Z",
  "calibrationDate": "2023-01-20T00:00:00Z",
  "nextCalibrationDate": "2024-01-20T00:00:00Z",
  "description": "Primary weighbridge for incoming and outgoing shipments",
  "notes": "Installed with new load cells and digital display"
}

### Get all weighbridges
GET {{WeighbridgeService_HostAddress}}/api/weighbridges

### Get weighbridge by ID
GET {{WeighbridgeService_HostAddress}}/api/weighbridges/{{weighbridgeId}}

### Get weighbridge by code
GET {{WeighbridgeService_HostAddress}}/api/weighbridges/code/WB001

### Get active weighbridges
GET {{WeighbridgeService_HostAddress}}/api/weighbridges/active

### Get available weighbridges
GET {{WeighbridgeService_HostAddress}}/api/weighbridges/available?requestedTime=2024-07-03T10:00:00Z

### Update weighbridge
PUT {{WeighbridgeService_HostAddress}}/api/weighbridges/{{weighbridgeId}}
Content-Type: application/json

{
  "name": "Main Loading Bay Weighbridge - Updated",
  "location": "Main Facility - Loading Bay A",
  "maxCapacity": 90000,
  "minCapacity": 100,
  "accuracy": 5,
  "status": 0,
  "description": "Primary weighbridge for incoming and outgoing shipments - capacity upgraded"
}

### Get weighbridge configuration
GET {{WeighbridgeService_HostAddress}}/api/weighbridges/{{weighbridgeId}}/configuration

### Update weighbridge configuration
PUT {{WeighbridgeService_HostAddress}}/api/weighbridges/{{weighbridgeId}}/configuration
Content-Type: application/json

{
  "configurationName": "Standard Configuration",
  "autoPrintTickets": 1,
  "requireDriverId": 1,
  "requireVehicleId": 1,
  "enableTareWeight": 1,
  "minimumWeight": 100,
  "maximumWeight": 90000,
  "stabilizationTime": 3,
  "autoZeroRange": 10,
  "weightUnit": "kg",
  "displayFormat": "0.00",
  "backupFrequency": 24,
  "alertThreshold": 85,
  "maintenanceInterval": 30,
  "calibrationInterval": 365
}

### Get weighbridge capacity
GET {{WeighbridgeService_HostAddress}}/api/weighbridges/{{weighbridgeId}}/capacity

### Update weighbridge capacity
PUT {{WeighbridgeService_HostAddress}}/api/weighbridges/{{weighbridgeId}}/capacity
Content-Type: application/json

{
  "currentLoad": 45000,
  "queueLength": 3,
  "estimatedWaitTime": 15,
  "isAvailable": true
}

### Get weighbridge location
GET {{WeighbridgeService_HostAddress}}/api/weighbridges/{{weighbridgeId}}/location

### Update weighbridge location
PUT {{WeighbridgeService_HostAddress}}/api/weighbridges/{{weighbridgeId}}/location
Content-Type: application/json

{
  "siteName": "Main Distribution Center",
  "address": "123 Industrial Way",
  "city": "Chicago",
  "state": "Illinois",
  "postalCode": "60601",
  "country": "United States",
  "latitude": 41.8781,
  "longitude": -87.6298,
  "contactPerson": "John Smith",
  "contactPhone": "+1-555-0123",
  "contactEmail": "john.smith@company.com",
  "operatingHoursStart": "06:00:00",
  "operatingHoursEnd": "22:00:00"
}

### Get calibration history
GET {{WeighbridgeService_HostAddress}}/api/weighbridges/{{weighbridgeId}}/calibration

### Schedule calibration
POST {{WeighbridgeService_HostAddress}}/api/weighbridges/{{weighbridgeId}}/calibration
Content-Type: application/json

{
  "scheduledDate": "2024-08-15T09:00:00Z",
  "type": 1,
  "calibrationCompany": "Precision Calibration Services",
  "notes": "Annual routine calibration"
}

### Record calibration results
PUT {{WeighbridgeService_HostAddress}}/api/calibrations/{{calibrationId}}
Content-Type: application/json

{
  "actualDate": "2024-08-15T09:30:00Z",
  "calibratedBy": "Mike Johnson, Certified Technician",
  "certificationNumber": "CAL-2024-0815",
  "calibrationCompany": "Precision Calibration Services",
  "testWeight1": 10000,
  "actualReading1": 10002,
  "testWeight2": 50000,
  "actualReading2": 50005,
  "testWeight3": 80000,
  "actualReading3": 80003,
  "accuracy": 5,
  "linearityError": 0.02,
  "repeatabilityError": 0.01,
  "isPassed": true,
  "nextCalibrationDate": "2025-08-15T00:00:00Z",
  "cost": 850.00,
  "notes": "Calibration completed successfully within specifications"
}

### Get scheduled calibrations
GET {{WeighbridgeService_HostAddress}}/api/calibrations/scheduled

### Get overdue calibrations
GET {{WeighbridgeService_HostAddress}}/api/calibrations/overdue

### Get maintenance schedule
GET {{WeighbridgeService_HostAddress}}/api/weighbridges/{{weighbridgeId}}/maintenance

### Schedule maintenance
POST {{WeighbridgeService_HostAddress}}/api/weighbridges/{{weighbridgeId}}/maintenance
Content-Type: application/json

{
  "scheduledDate": "2024-07-20T08:00:00Z",
  "type": 0,
  "priority": 1,
  "title": "Quarterly Preventive Maintenance",
  "description": "Routine cleaning, lubrication, and inspection of load cells and mechanical components",
  "assignedTo": "Maintenance Team Alpha",
  "estimatedDuration": 4,
  "estimatedCost": 500.00,
  "requiresCalibration": false
}

### Update maintenance
PUT {{WeighbridgeService_HostAddress}}/api/maintenance/{{maintenanceId}}
Content-Type: application/json

{
  "actualStartDate": "2024-07-20T08:15:00Z",
  "actualEndDate": "2024-07-20T12:00:00Z",
  "status": 2,
  "actualDuration": 3.75,
  "actualCost": 475.00,
  "workPerformed": "Cleaned all load cells, lubricated moving parts, replaced worn gaskets",
  "findings": "Minor wear on gasket seals, all other components in good condition",
  "recommendations": "Schedule next preventive maintenance in 3 months",
  "nextMaintenanceDate": "2024-10-20T00:00:00Z",
  "workOrderNumber": "WO-2024-0720"
}

### Get scheduled maintenance
GET {{WeighbridgeService_HostAddress}}/api/maintenance/scheduled

### Get overdue maintenance
GET {{WeighbridgeService_HostAddress}}/api/maintenance/overdue

### Get assigned operators
GET {{WeighbridgeService_HostAddress}}/api/weighbridges/{{weighbridgeId}}/operators

### Assign operator
POST {{WeighbridgeService_HostAddress}}/api/weighbridges/{{weighbridgeId}}/operators
Content-Type: application/json

{
  "operatorId": "EMP001",
  "firstName": "Sarah",
  "lastName": "Johnson",
  "email": "sarah.johnson@company.com",
  "phone": "+1-555-0124",
  "employeeNumber": "E12345",
  "certificationDate": "2024-01-15T00:00:00Z",
  "certificationExpiry": "2026-01-15T00:00:00Z",
  "certificationNumber": "WB-CERT-2024-001",
  "trainingLevel": "Advanced",
  "shift": "Morning",
  "canOperateAlone": true,
  "canCalibrate": false,
  "canPerformMaintenance": false,
  "accessLevel": "Operator"
}

### Unassign operator
DELETE {{WeighbridgeService_HostAddress}}/api/weighbridges/{{weighbridgeId}}/operators/EMP001

### Get operators needing training
GET {{WeighbridgeService_HostAddress}}/api/operators/training-needed

### Delete weighbridge
DELETE {{WeighbridgeService_HostAddress}}/api/weighbridges/{{weighbridgeId}}