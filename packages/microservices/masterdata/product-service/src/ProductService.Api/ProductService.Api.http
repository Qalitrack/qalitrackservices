@ProductService.Api_HostAddress = https://localhost:7098

### Get all products
GET {{ProductService.Api_HostAddress}}/api/products
Accept: application/json

### Get product by ID
GET {{ProductService.Api_HostAddress}}/api/products/1
Accept: application/json

### Register a new product
POST {{ProductService.Api_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Sample Product",
  "code": "SP001",
  "description": "This is a sample product for testing",
  "categoryId": "category-1",
  "unitOfMeasure": "kg",
  "weight": 10.5,
  "density": 1.2,
  "isHazardous": false,
  "requiresSpecialHandling": false,
  "notes": "Test product"
}

### Update a product
PUT {{ProductService.Api_HostAddress}}/api/products/1
Content-Type: application/json

{
  "name": "Updated Sample Product",
  "description": "This is an updated sample product",
  "categoryId": "category-1",
  "unitOfMeasure": "kg",
  "weight": 12.0,
  "density": 1.3,
  "isHazardous": false,
  "requiresSpecialHandling": false,
  "status": "Active",
  "notes": "Updated test product"
}

### Get products by category
GET {{ProductService.Api_HostAddress}}/api/products/category/category-1
Accept: application/json

### Get hazardous products
GET {{ProductService.Api_HostAddress}}/api/products/hazmat
Accept: application/json

### Search products
GET {{ProductService.Api_HostAddress}}/api/products/search?searchTerm=sample
Accept: application/json

### Get all categories
GET {{ProductService.Api_HostAddress}}/api/products/categories
Accept: application/json

### Get root categories
GET {{ProductService.Api_HostAddress}}/api/products/categories/root
Accept: application/json

### Create a new category
POST {{ProductService.Api_HostAddress}}/api/products/categories
Content-Type: application/json

{
  "name": "Test Category",
  "code": "TC001",
  "description": "This is a test category",
  "sortOrder": 1
}

### Get product specifications
GET {{ProductService.Api_HostAddress}}/api/products/1/specifications
Accept: application/json

### Get product pricing
GET {{ProductService.Api_HostAddress}}/api/products/1/pricing
Accept: application/json

### Get product compliance
GET {{ProductService.Api_HostAddress}}/api/products/1/compliance
Accept: application/json