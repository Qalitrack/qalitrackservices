@SupplierService_HostAddress = https://localhost:7006
@supplierId = {{$guid}}
@addressId = {{$guid}}
@productId = {{$guid}}
@pricingId = {{$guid}}

### Get all suppliers
GET {{SupplierService_HostAddress}}/api/suppliers
Accept: application/json

### Create a new supplier
POST {{SupplierService_HostAddress}}/api/suppliers
Content-Type: application/json

{
  "name": "ABC Manufacturing Co.",
  "code": "ABC001",
  "contactPerson": "John Smith",
  "email": "contact@abcmanufacturing.com",
  "phone": "+1-555-0123",
  "type": "Manufacturer",
  "description": "Leading manufacturer of industrial components",
  "website": "https://www.abcmanufacturing.com",
  "taxIdentificationNumber": "TAX123456789"
}

### Get supplier by ID (replace with actual ID)
GET {{SupplierService_HostAddress}}/api/suppliers/{{supplierId}}
Accept: application/json

### Get supplier by code
GET {{SupplierService_HostAddress}}/api/suppliers/code/ABC001
Accept: application/json

### Update supplier
PUT {{SupplierService_HostAddress}}/api/suppliers/{{supplierId}}
Content-Type: application/json

{
  "name": "ABC Manufacturing Co. Ltd.",
  "contactPerson": "Jane Smith",
  "email": "contact@abcmanufacturing.com",
  "phone": "+1-555-0123",
  "status": "Active",
  "type": "Manufacturer",
  "description": "Leading manufacturer of industrial components and solutions",
  "website": "https://www.abcmanufacturing.com",
  "taxIdentificationNumber": "TAX123456789"
}

### Search suppliers
GET {{SupplierService_HostAddress}}/api/suppliers/search?term=ABC
Accept: application/json

### Get suppliers by status
GET {{SupplierService_HostAddress}}/api/suppliers/status/Active
Accept: application/json

### Get suppliers by type
GET {{SupplierService_HostAddress}}/api/suppliers/type/Manufacturer
Accept: application/json

### Verify supplier
POST {{SupplierService_HostAddress}}/api/suppliers/{{supplierId}}/verify
Accept: application/json

### Delete supplier
DELETE {{SupplierService_HostAddress}}/api/suppliers/{{supplierId}}

### === ADDRESS ENDPOINTS ===

### Get supplier addresses
GET {{SupplierService_HostAddress}}/api/suppliers/{{supplierId}}/addresses
Accept: application/json

### Create supplier address
POST {{SupplierService_HostAddress}}/api/suppliers/{{supplierId}}/addresses
Content-Type: application/json

{
  "type": "Main",
  "street": "123 Industrial Blvd",
  "city": "Manufacturing City",
  "state": "MC",
  "postalCode": "12345",
  "country": "United States",
  "additionalInfo": "Building A, Floor 2",
  "isDefault": true,
  "latitude": 40.7128,
  "longitude": -74.0060
}

### Update supplier address
PUT {{SupplierService_HostAddress}}/api/suppliers/{{supplierId}}/addresses/{{addressId}}
Content-Type: application/json

{
  "street": "456 Updated Industrial Blvd",
  "city": "Manufacturing City",
  "state": "MC",
  "postalCode": "12346",
  "additionalInfo": "Building B, Floor 3"
}

### Delete supplier address
DELETE {{SupplierService_HostAddress}}/api/suppliers/{{supplierId}}/addresses/{{addressId}}

### === SUPPLIER PRODUCT ENDPOINTS ===

### Get supplier products
GET {{SupplierService_HostAddress}}/api/suppliers/{{supplierId}}/products
Accept: application/json

### Create supplier product
POST {{SupplierService_HostAddress}}/api/suppliers/{{supplierId}}/products
Content-Type: application/json

{
  "productId": "PROD-001",
  "supplierSKU": "ABC-BEARING-001",
  "leadTime": 14,
  "minOrderQuantity": 100,
  "isPreferred": true,
  "status": "Available",
  "notes": "High-quality industrial bearing for heavy machinery",
  "reorderLevel": 50,
  "currentStock": 500,
  "nextDeliveryDate": "2024-02-15T00:00:00Z"
}

### Update supplier product
PUT {{SupplierService_HostAddress}}/api/suppliers/{{supplierId}}/products/{{productId}}
Content-Type: application/json

{
  "supplierSKU": "ABC-BEARING-001-V2",
  "leadTime": 12,
  "minOrderQuantity": 75,
  "currentStock": 750,
  "notes": "Updated specifications for improved performance"
}

### Delete supplier product
DELETE {{SupplierService_HostAddress}}/api/suppliers/{{supplierId}}/products/{{productId}}

### Update product stock
POST {{SupplierService_HostAddress}}/api/supplierproducts/{{productId}}/stock
Content-Type: application/json

1000

### Set product as preferred
POST {{SupplierService_HostAddress}}/api/supplierproducts/{{productId}}/preferred
Content-Type: application/json

true

### === PRICING ENDPOINTS ===

### Get product pricing
GET {{SupplierService_HostAddress}}/api/supplierproducts/{{productId}}/pricing
Accept: application/json

### Create product pricing
POST {{SupplierService_HostAddress}}/api/supplierproducts/{{productId}}/pricing
Content-Type: application/json

{
  "type": "Standard",
  "amount": 45.99,
  "currency": "USD",
  "minQuantity": 1,
  "maxQuantity": 99,
  "validFrom": "2024-01-01T00:00:00Z",
  "validTo": "2024-12-31T23:59:59Z",
  "isActive": true,
  "priority": 1,
  "notes": "Standard pricing for small quantities"
}

### Get active pricing
GET {{SupplierService_HostAddress}}/api/supplierproducts/{{productId}}/pricing/active?quantity=50
Accept: application/json

### Calculate effective price
GET {{SupplierService_HostAddress}}/api/supplierproducts/{{productId}}/pricing/calculate?quantity=50
Accept: application/json

### Update pricing
PUT {{SupplierService_HostAddress}}/api/pricing/{{pricingId}}
Content-Type: application/json

{
  "amount": 42.99,
  "validTo": "2025-12-31T23:59:59Z",
  "notes": "Updated pricing with discount"
}

### Delete pricing
DELETE {{SupplierService_HostAddress}}/api/pricing/{{pricingId}}

### Get promotional pricing
GET {{SupplierService_HostAddress}}/api/pricing/promotional?supplierProductId={{productId}}
Accept: application/json

### Get expiring pricing
GET {{SupplierService_HostAddress}}/api/pricing/expiring?daysAhead=30
Accept: application/json

### === PERFORMANCE ENDPOINTS ===

### Get supplier performance
GET {{SupplierService_HostAddress}}/api/suppliers/{{supplierId}}/performance
Accept: application/json

### Create supplier performance record
POST {{SupplierService_HostAddress}}/api/suppliers/{{supplierId}}/performance
Content-Type: application/json

{
  "metricType": "DeliveryTime",
  "score": 85.5,
  "period": "Month",
  "periodStart": "2024-01-01T00:00:00Z",
  "periodEnd": "2024-01-31T23:59:59Z",
  "notes": "Good delivery performance with minor delays",
  "dataPoints": 25
}

### Get supplier performance summary
GET {{SupplierService_HostAddress}}/api/suppliers/{{supplierId}}/performance/summary
Accept: application/json