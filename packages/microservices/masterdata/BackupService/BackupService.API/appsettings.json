{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "/app/logs/backupservice.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level}] {Message}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId"  ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "${ConnectionStrings__DefaultConnection}",
    "Redis": "localhost:6379"
  },
  "UsePostgreSQL": true,
  "UseRedis": false,
  "BackupSettings": {
    "StoragePath": "/app/backups",
    "RetentionDays": 30,
    "ScheduleFrequency": "0 0 * * *"
  },
  "Email": {
    "FromEmail": "noreply@qalitrack.com",
    "FromName": "QaliTrack System",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": "587",
    "SmtpUsername": "joshuaiska@gmail.com",
    "SmtpPassword": "${EMAIL_SMTP_PASSWORD}",
    "EnableSsl": "true"
  },
  "RabbitMQ": {
    "Host": "rabbitmq",
    "Port": 5672,
    "Username": "admin",
    "Password": "${RABBITMQ_PASSWORD}",
    "VirtualHost": "/",
    "Queues": {
      "BackupServiceCommands": "backupservice.commands",
      "BackupServiceEvents": "backupservice.events"
    }
  },
  "Quartz": {
    "quartz": {
      "scheduler": {
        "instanceName": "DefaultQuartzScheduler",
        "instanceId": "AUTO"
      },
      "jobStore": {
        "type": "Quartz.Impl.AdoJobStore.JobStoreTX, Quartz",
        "useProperties": true,
        "dataSource": "default"
      },
      "dataSource": {
        "default": {
          "provider": "Npgsql",
          "connectionString": "Host=postgres-db;Port=5432;Database=quartzdb;Username=quartz;Password=quartz123"
        }
      }
    }
  }
}