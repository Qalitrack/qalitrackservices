{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "UsePostgreSQL": true,
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5435;Database=techniciandb;Username=technician;Password=technician123;Pooling=true;MinPoolSize=5;MaxPoolSize=100"
  },
  "DataProtection": {
    "SensitiveFields": [
      "password",
      "secret",
      "token",
      "apikey",
      "api_key",
      "connectionstring",
      "connection_string",
      "privatekey",
      "private_key",
      "ssn",
      "creditcard",
      "credit_card",
      "cvv",
      "pin"
