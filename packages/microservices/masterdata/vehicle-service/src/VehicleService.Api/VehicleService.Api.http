@VehicleService_Api_HostAddress = https://localhost:7030

### Get all vehicles
GET {{VehicleService_Api_HostAddress}}/api/vehicles
Accept: application/json

### Get all vehicle types
GET {{VehicleService_Api_HostAddress}}/api/vehicletypes
Accept: application/json

### Create a vehicle type
POST {{VehicleService_Api_HostAddress}}/api/vehicletypes
Content-Type: application/json

{
  "name": "Sedan",
  "description": "Standard passenger car",
  "category": "Personal",
  "maxWeightLimit": 2000.0,
  "requiresSpecialLicense": false
}

### Register a new vehicle
POST {{VehicleService_Api_HostAddress}}/api/vehicles
Content-Type: application/json

{
  "registrationNumber": "ABC123",
  "make": "Toyota",
  "model": "Camry",
  "year": 2022,
  "color": "White",
  "vin": "1HGBH41JXMN109186",
  "engineNumber": "ENG123456",
  "fuelType": "Petrol",
  "maxWeight": 1800.0,
  "tareWeight": 1400.0,
  "ownerName": "John Doe",
  "ownerContactInfo": "john.doe@example.com",
  "vehicleTypeId": "generated-vehicle-type-id",
  "currentMileage": 15000.0,
  "notes": "New vehicle registration"
}

### Get vehicle by registration number
GET {{VehicleService_Api_HostAddress}}/api/vehicles/by-registration/ABC123
Accept: application/json

### Get vehicles by status
GET {{VehicleService_Api_HostAddress}}/api/vehicles/by-status/Active
Accept: application/json

### Get vehicle with details
GET {{VehicleService_Api_HostAddress}}/api/vehicles/{vehicleId}/details
Accept: application/json

### Get expiring documents
GET {{VehicleService_Api_HostAddress}}/api/vehicledocuments/expiring?beforeDate=2024-12-31
Accept: application/json

### Get due inspections
GET {{VehicleService_Api_HostAddress}}/api/vehicleinspections/due?beforeDate=2024-12-31
Accept: application/json

### Get expiring insurance
GET {{VehicleService_Api_HostAddress}}/api/vehicleinsurance/expiring?beforeDate=2024-12-31
Accept: application/json

###
