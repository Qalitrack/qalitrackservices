{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=userservice.db",
    "PostgreSQL": "Host=postgres-db;Database=userservicedb;Username=userservice;Password=userservice123;Pooling=true;MinPoolSize=5;MaxPoolSize=100;Include Error Detail=true;Command Timeout=60",
    "Redis": "localhost:6379"
  },
  "UsePostgreSQL": false,
  "UseRedis": false,
  "JwtSettings": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "AccessTokenExpirationMinutes": "30",
    "RefreshTokenExpirationDays": "7"
  },
  "Security": {
    "MaxFailedAttempts": "5",
    "LockoutMinutes": "30"
  },
  "Password": {
    "WorkFactor": "12"
  },
  "Email": {
    "FromEmail": "noreply@qalitrack.com",
    "FromName": "QaliTrack System",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": "587",
    "SmtpUsername": "joshuaiska@gmail.com",
    "SmtpPassword": "dgln ffbs ixvg pxuj",
    "EnableSsl": "true"
  },
  "App": {
    "BaseUrl": "https://localhost:7001"
  },
  "Docker": {
    "PostgresContainerName": "userservice-postgres",
    "BackupMountPath": "/var/backups"
  },
  "Backup": {
    "Path": "${BACKUP_PATH}",
    "WalArchivePath": "${WAL_ARCHIVE_PATH}",
    "RetentionPolicy": {
      "FullBackupDays": 30,
      "IncrementalBackupDays": 7
    }
  }
}