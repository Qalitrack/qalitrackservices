{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "ForwardedHeaders": "All"
  },
  "ReverseProxy": {
    "Routes": {
      "tech-user-route": {
        "ClusterId": "tech-user-cluster",
        "AuthorizationPolicy": "Public",
        "Match": { "Path": "/api/tech/user/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/tech/user" }
        ],
        "Order": 0
      },
      "qtruck-api-route": {
        "ClusterId": "qtruck-api-cluster",
        "AuthorizationPolicy": "Public",
        "Match": { "Path": "/api/qtruck/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/qtruck" }
        ],
        "Order": 0
      },
      "qtruck-frontend-route": {
        "ClusterId": "qtruck-frontend-cluster",
        "AuthorizationPolicy": "Public",
        "Match": { "Path": "/qtruck/{**catch-all}" },
        "Order": 0
      },
      "api-route": {
        "ClusterId": "backend-cluster",
        "AuthorizationPolicy": "Public",
        "Match": { "Path": "/api/{**catch-all}" },
        "Order": 1
      },
      "frontend-route": {
        "ClusterId": "frontend-cluster",
        "AuthorizationPolicy": "Public",
        "Match": { "Path": "{**catch-all}" },
        "Order": 2
      }
    },
    "Clusters": {
      "tech-user-cluster": {
        "Destinations": {
          "tech-user": { "Address": "http://qalitrack-user-service-prod:80" }
        }
      },
      "qtruck-api-cluster": {
        "Destinations": {
          "qtruck-api": { "Address": "http://qtruck-api-prod:8000" }
        }
      },
      "qtruck-frontend-cluster": {
        "Destinations": {
          "qtruck-frontend": { "Address": "http://qtruck-frontend-prod:3000" }
        }
      },
      "backend-cluster": {
        "Destinations": {
          "backend": { "Address": "http://qs-backend-prod:5000" }
        }
      },
      "frontend-cluster": {
        "Destinations": {
          "frontend": { "Address": "http://qs-frontend-prod:80" }
        }
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://qalibrated.co.ke",
      "https://www.qalibrated.co.ke",
      "https://app.qalibrated.co.ke",
      "http://localhost:3000",
      "http://localhost:5000",
      "http://localhost:5173",
      "http://localhost:7000"
    ],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"],
    "AllowedHeaders": ["Content-Type", "Authorization", "X-Requested-With", "X-User-Id", "X-User-Email"],
    "AllowCredentials": true,
    "MaxAge": 3600
  }
}