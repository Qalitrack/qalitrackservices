{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:80"
      },
      "Https": {
        "Url": "https://0.0.0.0:443",
        "Certificate": {
          "Path": "/certs/fullchain1.pem",
          "KeyPath": "/certs/privkey1.pem"
        }
      }
    }
  },
  "HttpsRedirection": {
    "HttpsPort": null
  },
  "ForwardedHeaders": {
    "ForwardedHeaders": "All"
  },
  "ReverseProxy": {
    "Routes": {
      "frontend-route": {
        "ClusterId": "frontend-cluster",
        "AuthorizationPolicy": "Public",
        "Match": {
          "Path": "{**catch-all}"
        },
        "Order": 1
      }
    },
    "Clusters": {
      "frontend-cluster": {
        "Destinations": {
          "frontend": {
            "Address": "http://qs-frontend-prod:700"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": false
        }
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://qalibrated.com"
    ],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"],
    "AllowedHeaders": ["Content-Type", "Authorization", "X-Requested-With", "X-User-Id", "X-User-Email"],
    "AllowCredentials": true,
    "MaxAge": 3600
  }
}