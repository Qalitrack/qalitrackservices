{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "ForwardedHeaders": "All"
  },
  "ReverseProxy": {
    "Routes": {
      "api-route": {
        "ClusterId": "backend-cluster",
        "AuthorizationPolicy": "Public",
        "Match": { "Path": "/api/{**catch-all}" },
        "Order": 0
      },
      "frontend-route": {
        "ClusterId": "frontend-cluster",
        "AuthorizationPolicy": "Public",
        "Match": { "Path": "{**catch-all}" },
        "Order": 1
      }
    },
    "Clusters": {
      "backend-cluster": {
        "Destinations": {
          "backend": { "Address": "http://qs-backend-prod:5000" }
        }
      },
      "frontend-cluster": {
        "Destinations": {
          "frontend": { "Address": "http://qs-frontend-prod:80" }
        }
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://qalibrated.com",
      "https://www.qalibrated.com",
      "http://localhost:3000",
      "http://localhost:7000"
    ],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"],
    "AllowedHeaders": ["Content-Type", "Authorization", "X-Requested-With", "X-User-Id", "X-User-Email"],
    "AllowCredentials": true,
    "MaxAge": 3600
  }
}