{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "src",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "noRestore": true,
      "namespaceLayout": "flattened",
      "memberLayout": "samePage"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}",
          "toc.yml",
          "index.md"
        ],
        "exclude": [
          "_site/**",
          "obj/**",
          "bin/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "QaliTrack Gateway Service",
      "_appTitle": "QaliTrack Gateway Service API Documentation",
      "_enableSearch": true,
      "_enableNewTab": true,
      "pdf": false,
      "_gitContribute": {
        "repo": "https://github.com/yourusername/qalitrackservices",
        "branch": "main",
        "path": "packages/qalitrack-gateway"
      }
    },
    "postProcessors": ["ExtractSearchIndex"]
  }
}