{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Ocelot": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "YourSuperSecretKeyForJWTWhichShouldBeAtLeast32CharactersLong!",
    "Issuer": "UserService",
    "Audience": "UserService"
  },
  "Consul": {
    "Host": "localhost",
    "Port": 8500,
    "Datacenter": "dc1"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gateway-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Audit": {
    "EnableAuditLogging": true,
    "TransactionServiceBaseUrl": "http://transaction-service",
    "AuditEndpoint": "/api/audit/gateway",
    "BatchAuditEndpoint": "/api/audit/gateway/batch",
    "EnableBatchProcessing": true,
    "BatchSize": 50,
    "BatchIntervalSeconds": 30,
    "HttpTimeoutSeconds": 30,
    "RetryAttempts": 3,
    "RetryDelayMs": 1000,
    "EnableHealthCheckAudit": false,
    "EnableAuthorizationAudit": true,
    "EnableGatewayRequestAudit": true,
    "MinimumLogLevel": "Information",
    "EnableCorrelationId": true,
    "EnableEventFiltering": true,
    "ExcludePaths": "/health,/swagger,/metrics",
    "IncludeHttpMethods": ""
  },
  "Monitoring": {
    "EnableHealthMonitoring": true,
    "DefaultHealthCheckIntervalSeconds": 30,
    "DefaultTimeoutSeconds": 10,
    "DegradedResponseTimeMs": 5000,
    "MaxConsecutiveFailures": 3,
    "EnableHealthCheckAudit": false,
    "HealthCheckAuditIntervalSeconds": 300,
    "MaxHealthHistoryRecords": 1000,
    "HealthDataRetentionHours": 168,
    "EnableDependencyTracking": true,
    "EnablePerformanceMetrics": true,
    "EnableAlerting": true,
    "AlertHealthScoreThreshold": 80.0,
    "EnableAutoDiscovery": false,
    "AutoDiscoveryPatterns": "*-service",
    "EnableCircuitBreaker": true,
    "CircuitBreakerFailureThreshold": 5,
    "CircuitBreakerTimeoutSeconds": 60,
    "EnableHealthBasedLoadBalancing": true,
    "ServiceDefaults": {
      "Environment": "development",
      "HealthCheckPath": "/health",
      "DefaultPort": 80,
      "DefaultProtocol": "http",
      "DefaultTags": [],
      "AutoRegisterDiscoveredServices": true
    }
  }
}