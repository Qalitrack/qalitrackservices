# QaliTrack Master Data Service Configuration
# Copy this file to .env and update with your settings

# Database Provider - PostgreSQL or SQLite
DB_PROVIDER=SQLite

# SQLite Configuration (Default)
DB_PATH=masterdata.db

# PostgreSQL Configuration (when DB_PROVIDER=PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qalitrack_masterdata
DB_USER=postgres
DB_PASSWORD=your_password_here

# Django-style Module Configuration
# Enable/disable modules (comma-separated list)
ENABLED_MODULES=Organization,Driver,Vehicle,BusinessEntities,SACCO,Product,Route,Weighbridge

# Application Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# Logging
LOGGING_LEVEL=Information