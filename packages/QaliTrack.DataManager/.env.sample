# QaliTrack Data Manager Service Environment Configuration

# Database Configuration
DATABASE_PROVIDER=SQLite                    # SQLite, PostgreSQL, SqlServer
CONNECTION_STRING="Data Source=datamanager.db"

# For PostgreSQL (recommended for production)
# CONNECTION_STRING="Host=localhost;Database=qalitrack_datamanager;Username=app;Password=your_password;Port=5432"

# For SQL Server (enterprise environments)
# CONNECTION_STRING="Server=localhost;Database=QaliTrackDataManager;Integrated Security=true;TrustServerCertificate=true"

# Master Data Service Integration
MASTERDATA_SERVICE_URL=http://localhost:3000
MASTERDATA_SERVICE_TIMEOUT=30

# Authentication & Security
JWT_SECRET_KEY=your-256-bit-secret-key-change-this-in-production
JWT_ISSUER=https://auth.qalitrack.com
JWT_AUDIENCE=qalitrack-datamanager

# Multi-Tenancy
DEFAULT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000

# Redis Caching (optional - uses in-memory caching if not configured)
REDIS_CONNECTION_STRING=localhost:6379

# Logging Configuration
SERILOG_MINIMUM_LEVEL=Information
# ELASTIC_SEARCH_URL=https://elasticsearch.example.com:9200

# API Configuration
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=20
CACHE_DURATION_MINUTES=5

# Health Checks
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_PORT=5000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,https://app.qalitrack.com

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_HOUR=1000
RATE_LIMIT_BURST_REQUESTS_PER_MINUTE=100

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_PATH=/app/uploads

# Email Notifications (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notifications@qalitrack.com
SMTP_PASSWORD=your_smtp_password
SMTP_USE_SSL=true

# Webhook Configuration (optional)
WEBHOOK_SECRET=your-webhook-secret-key
WEBHOOK_TIMEOUT_SECONDS=30

# Background Job Processing
HANGFIRE_CONNECTION_STRING=your_hangfire_connection_string
HANGFIRE_DASHBOARD_ENABLED=false

# Monitoring and Observability
APPLICATION_INSIGHTS_KEY=your_application_insights_key
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Development Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5000

# SSL/TLS Configuration (production)
# ASPNETCORE_Kestrel__Certificates__Default__Password=certificate_password
# ASPNETCORE_Kestrel__Certificates__Default__Path=/app/certificates/qalitrack.pfx