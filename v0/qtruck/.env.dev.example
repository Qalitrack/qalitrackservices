# QTruck Development Environment Configuration

# Port Configuration
FRONTEND_PORT=3000
API_PORT=5000
POSTGRES_PORT=5432
REDIS_PORT=6379
ADMINER_PORT=8080

# Database Configuration
DEV_DATABASE_URL=postgresql://qtruck_user:qtruck_password@postgres-dev:5432/qtruck_db
DEV_POSTGRES_DB=qtruck_db
DEV_POSTGRES_USER=qtruck_user
DEV_POSTGRES_PASSWORD=qtruck_password

# Security (Development only - change for production)
DEV_JWT_SECRET=dev-secret-change-in-production