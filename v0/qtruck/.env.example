# QTruck Production Environment Configuration

# Domain Configuration
DOMAIN=qtruck.example.com

# Docker Images
QTRUCK_FRONTEND_IMAGE=ghcr.io/qalitrack/qalitrackservices/qtruck-frontend:latest
QTRUCK_API_IMAGE=ghcr.io/qalitrack/qalitrackservices/qtruck-api:latest

# Database Configuration
DATABASE_URL=postgresql://qtruck_user:secure_password@postgres.example.com:5432/qtruck_production

# Security
JWT_SECRET_KEY=your-super-secure-jwt-secret-key-change-this

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Optional: External Redis
# REDIS_URL=redis://external-redis.example.com:6379/0