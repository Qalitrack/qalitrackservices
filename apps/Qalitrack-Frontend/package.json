{
  "name": "qalitrack-frontend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "EXPO_NO_VERSION_CHECK=1 expo start --web",
    "desktop": "concurrently \"npm run web\" \"wait-on http://localhost:19006 && electron .\""
