# Backend Dockerfile
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (all for now, can optimize later)
RUN npm ci

# Copy server file and backend directory
COPY server.js ./
COPY backend/ ./backend/

# Expose port
EXPOSE 5000

# Set environment variables
ENV NODE_ENV=production

# Start command
CMD ["npm", "start"]