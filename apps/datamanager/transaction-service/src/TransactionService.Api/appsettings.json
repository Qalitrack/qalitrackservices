{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=transaction_service.db"
  },
  "JwtSettings": {
    "Key": "YourSecretKeyHere123456789",
    "Issuer": "TransactionService",
    "Audience": "TransactionServiceClients",
    "ExpirationMinutes": 60
  },
  "MasterDataServices": {
    "VehicleService": "http://localhost:5001",
    "DriverService": "http://localhost:5002",
    "SupplierService": "http://localhost:5003",
    "ProductService": "http://localhost:5004",
    "RouteService": "http://localhost:5005",
    "WeighbridgeService": "http://localhost:5006",
    "OrganizationService": "http://localhost:5007"
  },
  "FileStorage": {
    "BasePath": "./uploads",
    "MaxFileSize": 10485760,
    "AllowedExtensions": [".pdf", ".jpg", ".jpeg", ".png", ".doc", ".docx"]
  }
}