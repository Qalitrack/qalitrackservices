<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
    <StartupObject />
  </PropertyGroup>
  
  <!-- Set the default startup project -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'WorkspaceService.Api'">
    <IsRunnableProject>true</IsRunnableProject>
  </PropertyGroup>
</Project>