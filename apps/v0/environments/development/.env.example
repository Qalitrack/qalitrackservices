# Development Environment Configuration Template
# This file contains placeholder values that will be replaced with unique secrets
# Run: ./shared/scripts/generate-secrets.sh development

ENVIRONMENT=development
COMPOSE_PROJECT_NAME=qalitrack-dev

# Network Configuration
NETWORK_SUBNET=172.20.0.0/16

# Infrastructure Ports (Development - Standard ports)
POSTGRES_PORT=5432
POSTGRES_BACKUP_PORT=5435
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
VAULT_PORT=8200
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
ZINCSEARCH_PORT=4080

# Microservices Control Hub (Infrastructure Monitoring)
MICROSERVICES_HUB_PORT=3000
MICROSERVICES_HUB_HOST=status.localhost

# API Gateway Configuration (Future)
API_GATEWAY_PORT=8080
API_GATEWAY_HOST=api.localhost

# Application Ports (Development)
MASTERDATA_PORT=7001
TRANSACTION_PORT=7002
WEIGHT_DATA_PORT=7003
BACKUP_SERVICE_PORT=7005

# Nginx Configuration
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Vault Configuration (Development)
VAULT_ROOT_TOKEN=PLACEHOLDER_VAULT_ROOT_TOKEN
VAULT_ADDR=http://localhost:8200

# Database Configuration (Admin credentials for Vault management)
POSTGRES_ADMIN_USER=vault-admin
POSTGRES_ADMIN_PASSWORD=PLACEHOLDER_POSTGRES_ADMIN_PASSWORD
POSTGRES_BACKUP_ADMIN_USER=vault-backup-admin
POSTGRES_BACKUP_ADMIN_PASSWORD=PLACEHOLDER_POSTGRES_BACKUP_ADMIN_PASSWORD

# Database Performance Settings (Development)
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB

# Service Credentials (Admin - for Vault management only)
REDIS_ADMIN_PASSWORD=PLACEHOLDER_REDIS_ADMIN_PASSWORD
RABBITMQ_ADMIN_USER=vault-rabbitmq-admin
RABBITMQ_ADMIN_PASSWORD=PLACEHOLDER_RABBITMQ_ADMIN_PASSWORD
MINIO_ADMIN_USER=vault-minio-admin
MINIO_ADMIN_PASSWORD=PLACEHOLDER_MINIO_ADMIN_PASSWORD
ZINCSEARCH_ADMIN_USER=vault-zinc-admin
ZINCSEARCH_ADMIN_PASSWORD=PLACEHOLDER_ZINCSEARCH_ADMIN_PASSWORD

# Resource Limits (Development)
REDIS_MAXMEMORY=512mb
MINIO_MEMORY_LIMIT=1g

# Backup Configuration
BACKUP_RETENTION_DAYS=7
BACKUP_PATH=./backups/development

# External Backup Configuration
EXTERNAL_BACKUP_ENABLED=false
EXTERNAL_BACKUP_HOST=backup.example.com
EXTERNAL_BACKUP_USER=qalitrack-backup
EXTERNAL_BACKUP_PATH=/backups/qalitrack/development

# Security Settings (Development)
VAULT_DISABLE_MLOCK=true
POSTGRES_SSL_MODE=disable
REDIS_PROTECTED_MODE=no

# Domain Configuration (Development)
DOMAIN_NAME=localhost
API_DOMAIN=api.localhost
ADMIN_DOMAIN=admin.localhost

# SSL Configuration (Development - not used)
SSL_ENABLED=false
LETSENCRYPT_EMAIL=admin@localhost