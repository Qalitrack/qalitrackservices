# Production Environment Configuration Template
# This file contains placeholder values that will be replaced with unique secrets
# Run: ./shared/scripts/generate-secrets.sh production

ENVIRONMENT=production
COMPOSE_PROJECT_NAME=qalitrack-prod

# Network Configuration
NETWORK_SUBNET=172.30.0.0/16

# Infrastructure Ports (Production - Offset by 10000 to avoid conflicts)
POSTGRES_PORT=15432
POSTGRES_BACKUP_PORT=15435
REDIS_PORT=16379
RABBITMQ_PORT=15672
RABBITMQ_MGMT_PORT=25672
VAULT_PORT=18200
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
MAILPIT_SMTP_PORT=11025
MAILPIT_WEB_PORT=18025
ZINCSEARCH_PORT=14080

# Microservices Control Hub (Infrastructure Monitoring)
MICROSERVICES_HUB_PORT=13000
MICROSERVICES_HUB_HOST=status.yourdomain.com

# API Gateway Configuration (Future)
API_GATEWAY_PORT=18080
API_GATEWAY_HOST=api.yourdomain.com

# Application Ports (Production)
MASTERDATA_PORT=17001
TRANSACTION_PORT=17002
WEIGHT_DATA_PORT=17003
BACKUP_SERVICE_PORT=17005

# Nginx Configuration
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Vault Configuration (Production)
VAULT_ROOT_TOKEN=PLACEHOLDER_VAULT_ROOT_TOKEN
VAULT_ADDR=http://localhost:18200

# Database Configuration (Admin credentials for Vault management)
POSTGRES_ADMIN_USER=vault-admin
POSTGRES_ADMIN_PASSWORD=PLACEHOLDER_POSTGRES_ADMIN_PASSWORD
POSTGRES_BACKUP_ADMIN_USER=vault-backup-admin
POSTGRES_BACKUP_ADMIN_PASSWORD=PLACEHOLDER_POSTGRES_BACKUP_ADMIN_PASSWORD

# Database Performance Settings (Production)
POSTGRES_MAX_CONNECTIONS=500
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=4GB

# Service Credentials (Admin - for Vault management only)
REDIS_ADMIN_PASSWORD=PLACEHOLDER_REDIS_ADMIN_PASSWORD
RABBITMQ_ADMIN_USER=vault-rabbitmq-admin
RABBITMQ_ADMIN_PASSWORD=PLACEHOLDER_RABBITMQ_ADMIN_PASSWORD
MINIO_ADMIN_USER=vault-minio-admin
MINIO_ADMIN_PASSWORD=PLACEHOLDER_MINIO_ADMIN_PASSWORD
ZINCSEARCH_ADMIN_USER=vault-zinc-admin
ZINCSEARCH_ADMIN_PASSWORD=PLACEHOLDER_ZINCSEARCH_ADMIN_PASSWORD

# Resource Limits (Production)
REDIS_MAXMEMORY=2gb
MINIO_MEMORY_LIMIT=4g

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=./backups/production

# External Backup Configuration (IMPORTANT: Configure for production)
EXTERNAL_BACKUP_ENABLED=true
EXTERNAL_BACKUP_HOST=backup.yourdomain.com
EXTERNAL_BACKUP_USER=qalitrack-backup
EXTERNAL_BACKUP_PATH=/backups/qalitrack/production
EXTERNAL_BACKUP_SSH_KEY_PATH=~/.ssh/qalitrack_backup_key

# GPG Encryption for External Backups
GPG_ENCRYPTION_ENABLED=true
GPG_RECIPIENT_EMAIL=backup@yourdomain.com
GPG_KEY_ID=YOUR_GPG_KEY_ID

# Security Settings (Production)
VAULT_DISABLE_MLOCK=false
POSTGRES_SSL_MODE=require
REDIS_PROTECTED_MODE=yes

# Domain Configuration (Production - CHANGE THESE)
DOMAIN_NAME=yourdomain.com
API_DOMAIN=api.yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com
MEDIA_DOMAIN=media.yourdomain.com

# SSL Configuration (Production)
SSL_ENABLED=true
LETSENCRYPT_EMAIL=admin@yourdomain.com
SSL_DOMAINS="yourdomain.com www.yourdomain.com api.yourdomain.com admin.yourdomain.com media.yourdomain.com"

# Monitoring and Alerting (Future)
MONITORING_ENABLED=true
ALERT_EMAIL=alerts@yourdomain.com

# Performance Optimization
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=1024
NGINX_GZIP_ENABLED=true
NGINX_CACHE_ENABLED=true