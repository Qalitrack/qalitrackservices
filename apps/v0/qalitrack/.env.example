# QaliTrack Single Traefik Configuration
# Copy this file to .env and customize your domains

# Development domains (for local testing)
QALITRACK_DEV_DOMAIN=qalitrack.localhost
QALITRACK_DEV_ALT_DOMAIN=qalitrack-dev.localhost

# Production domain (your actual domain)
QALITRACK_PROD_DOMAIN=qalitrack.cseco.co.ke

# Examples for different setups:
# 
# Local development:
# QALITRACK_DEV_DOMAIN=qalitrack.localhost
# QALITRACK_DEV_ALT_DOMAIN=qalitrack-dev.localhost
# QALITRACK_PROD_DOMAIN=qalitrack.yourdomain.com
#
# Staging/Production:
# QALITRACK_DEV_DOMAIN=qalitrack-staging.yourdomain.com  
# QALITRACK_PROD_DOMAIN=qalitrack.yourdomain.com