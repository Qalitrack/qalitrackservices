{
  "environment": "development",
  "version": "1.0.0",
  "applicationName": "QaliTrack",
  "servers": [
    {
      "url": "http://localhost:7000",
      "description": "Local Development"
    },
    {
      "url": "https://api-staging.qalitrack.com",
      "description": "Staging Environment"
    },
    {
      "url": "https://api.qalitrack.com", 
      "description": "Production Environment"
    }
  ],
  "external": {
    "host": "localhost",
    "protocol": "http",
    "gatewayPort": "7000"
  },
  "services": [
    {
      "name": "qalitrack-masterdata",
      "host": "qalitrack-masterdata",
      "port": 80,
      "group": "masterdata",
      "enabled": true,
      "healthPath": "/health",
      "swaggerPath": "/swagger/v1/swagger.json",
      "apiRoot": "/api/masterdata",
      "guidesPath": "/docs",
      "description": "Consolidated MasterData service (customers, drivers, products, reports, routes, saccos, suppliers, transporters, vehicles, weighbridges, organizations, relationships)",
      "modules": [
        {
          "name": "customers",
          "path": "/api/masterdata/business-entities",
          "description": "Customer management"
        },
        {
          "name": "drivers", 
          "path": "/api/masterdata/drivers",
          "description": "Driver management"
        },
        {
          "name": "products",
          "path": "/api/masterdata/products", 
          "description": "Product catalog"
        },
        {
          "name": "reports",
          "path": "/api/masterdata/reports",
          "description": "Reporting system"
        },
        {
          "name": "routes",
          "path": "/api/masterdata/routes",
          "description": "Route management"
        },
        {
          "name": "saccos",
          "path": "/api/masterdata/saccos",
          "description": "SACCO integration"
        },
        {
          "name": "suppliers",
          "path": "/api/masterdata/business-entities",
          "description": "Supplier management"  
        },
        {
          "name": "transporters",
          "path": "/api/masterdata/business-entities",
          "description": "Transporter management"
        },
        {
          "name": "vehicles",
          "path": "/api/masterdata/vehicles",
          "description": "Vehicle management"
        },
        {
          "name": "weighbridges",
          "path": "/api/masterdata/weighbridges",
          "description": "Weighbridge management"
        },
        {
          "name": "organizations",
          "path": "/api/masterdata/organizations",
          "description": "Organization management"
        },
        {
          "name": "relationships",
          "path": "/api/masterdata/relationships",
          "description": "Cross-module relationships"
        }
      ]
    },
    {
      "name": "transaction-service",
      "host": "transaction-service",
      "port": 80,
      "group": "datamanager",
      "enabled": true,
      "healthPath": "/health",
      "swaggerPath": "/swagger/v1/swagger.json",
      "apiRoot": "/api/transactions",
      "description": "Transaction processing service"
    },
    {
      "name": "weight-data-service",
      "host": "weight-data-service",
      "port": 80,
      "group": "datamanager",
      "enabled": true,
      "healthPath": "/health",
      "swaggerPath": "/swagger/v1/swagger.json",
      "apiRoot": "/api/weight-data",
      "description": "Weight data processing service"
    },
    {
      "name": "operational-data-service",
      "host": "operational-data-service",
      "port": 80,
      "group": "datamanager",
      "enabled": true,
      "healthPath": "/health",
      "swaggerPath": "/swagger/v1/swagger.json",
      "apiRoot": "/api/operational-data",
      "description": "Operational data processing service"
    },
    {
      "name": "backup-service",
      "host": "backup-service",
      "port": 80,
      "group": "infrastructure",
      "enabled": true,
      "healthPath": "/health",
      "swaggerPath": "/swagger/v1/swagger.json",
      "apiRoot": "/api/backup",
      "description": "Backup and archive service"
    },
    {
      "name": "postgres",
      "host": "postgres",
      "port": 5432,
      "group": "infrastructure",
      "enabled": true,
      "healthPath": null,
      "swaggerPath": null,
      "description": "PostgreSQL primary database"
    },
    {
      "name": "redis",
      "host": "redis",
      "port": 6379,
      "group": "infrastructure",
      "enabled": true,
      "healthPath": null,
      "swaggerPath": null,
      "description": "Redis cache and session store"
    },
    {
      "name": "rabbitmq",
      "host": "rabbitmq",
      "port": 5672,
      "group": "infrastructure",
      "enabled": true,
      "healthPath": null,
      "swaggerPath": null,
      "description": "RabbitMQ message broker"
    },
    {
      "name": "mailpit",
      "host": "mailpit",
      "port": 1025,
      "group": "infrastructure",
      "enabled": true,
      "healthPath": null,
      "swaggerPath": null,
      "description": "Mailpit email testing service"
    }
  ]
}