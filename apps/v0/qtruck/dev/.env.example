# Docker Compose Project Name
COMPOSE_PROJECT_NAME=qtruck-api-dev

# Database Configuration
DB_NAME=qtruck_db_dev
DB_USER=qtruck_user
DB_PASSWORD=your_secure_password

# Django Configuration
DEBUG=True
SECRET_KEY=your-secret-key-here
# Domain Configuration
PRIMARY_DOMAIN=qtruck-dev.qalibrated.cseco.co.ke
API_DOMAIN=api.qtruck-dev.qalibrated.cseco.co.ke
ALLOWED_HOSTS=localhost,127.0.0.1,qtruck-api-dev,${PRIMARY_DOMAIN}
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://${PRIMARY_DOMAIN}

# Media and Static
MEDIA_ROOT=media/
STATIC_ROOT=static/
DATABASE_FLUSH_ENABLED=True