# QTruck API Production Environment Variables

# Database Configuration
DB_NAME=qtruck_prod
DB_USER=qtruck_user
DB_PASSWORD=secure_password_here

# Django Configuration
SECRET_KEY=your-super-secret-django-key-here
# Domain Configuration
PRIMARY_DOMAIN=qtruck.qalibrated.cseco.co.ke
API_DOMAIN=api.qtruck.qalibrated.cseco.co.ke
ALLOWED_HOSTS=${PRIMARY_DOMAIN},${API_DOMAIN}
CORS_ALLOWED_ORIGINS=https://${PRIMARY_DOMAIN}

# Email Configuration (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@domain.com
EMAIL_HOST_PASSWORD=your-email-password

# AWS/S3 Configuration (if using)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=qtruck-storage
AWS_S3_REGION_NAME=us-east-1

# Additional Security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True