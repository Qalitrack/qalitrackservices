{
  "name": "s4hana-public-edition-integration",
  "version": "1.0.0",
  "private": true,
  "description": "SAP S/4HANA Public Edition OData v4 Integration Server for Development and Testing",
  "keywords": [
    "sap",
    "s4hana",
    "odata",
    "integration",
    "public-edition",
    "development"
  ],
  "main": "webapp/index.html",
  "scripts": {
    "start": "node server.js",
    "start-ui5": "ui5 serve --config ui5-mock.yaml",
    "start-local": "ui5 serve --config ui5-local.yaml",
    "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
    "lint": "eslint server.js",
    "test": "node -c server.js && echo \"✓ Server syntax validation passed\"",
    "docker:build": "docker build -t qalitrack/s4hana-mock-server .",
    "docker:run": "docker-compose -f docker-compose.s4hana-mock.yml up -d",
    "docker:run-nginx": "docker-compose -f docker-compose.s4hana-nginx.yml up -d",
    "docker:stop-nginx": "docker-compose -f docker-compose.s4hana-nginx.yml down"
  },
  "dependencies": {
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "redoc-express": "^2.1.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.14.7",
    "@sap-ux/ui5-middleware-fe-mockserver": "^2.2.99",
    "@sap/eslint-plugin-ui5-jsdocs": "^2.0.5",
    "@sap/ux-specification": "UI5-1.84",
    "@sap/ux-ui5-tooling": "^1.7.0",
    "@sapui5/ts-types": "^1.92.2",
    "@ui5/cli": "^3.3.4",
    "eslint": "^7.32.0",
    "eslint-plugin-fiori-custom": "^2.2.1"
  },
  "ui5": {
    "dependencies": [
      "@sap/ux-ui5-tooling",
      "@sap-ux/ui5-middleware-fe-mockserver"
    ]
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adarlegendre/qalitrackservices"
  },
  "author": "QaliTrack Systems",
  "license": "UNLICENSED"
}
