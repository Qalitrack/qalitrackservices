{
  "name": "qalitrack",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "web": "cross-env WEB_ONLY=1 vite",
    "build": "vite build",
    "build:main": "cross-env WEB_ONLY=1 vite build",
    "build:kiosk": "cross-env VITE_APP_TARGET=kiosk vite build",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder",
    "electron:build:kiosk": "cross-env VITE_APP_TARGET=kiosk ELECTRON_KIOSK=1 vite build && mv dist/kiosk.html dist/index.html && electron-builder",
    "electron:preview": "electron ."
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@reduxjs/toolkit": "^2.2.0",
    "antd": "^5.27.6",
    "apexcharts": "^5.3.5",
    "axios": "^1.6.0",
    "chart.js": "^4.5.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^5.1.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.23.25",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "localforage": "^1.10.0",
    "lucide-react": "^0.544.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-apexcharts": "^1.7.0",
    "react-chartjs-2": "^5.3.0",
    "react-countup": "^6.5.3",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-redux": "^8.1.0",
    "react-router-dom": "^6.21.0",
    "react-toastify": "^11.0.5",
    "recharts": "^3.2.0",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.7.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "jimp": "^1.6.1",
    "playwright-core": "^1.61.1",
    "postcss": "^8.4.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-pwa": "^1.0.2"
  },
  "build": {
    "appId": "com.qalibrated.qalitrack",
    "productName": "Qalitrack",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    }
  }
}
