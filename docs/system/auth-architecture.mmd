graph TB
    subgraph "Client Applications"
        WEB[Web Dashboard]
        MOBILE[Mobile App]
        API_CLIENT[API Client]
    end

    subgraph "API Gateway Layer"
        GATEWAY[API Gateway<br/>- Authentication<br/>- Rate Limiting<br/>- Routing]
    end

    subgraph "Core Services"
        USER_SVC[User Service<br/>- User Management<br/>- Role Management<br/>- Permissions]
        WEIGHT_SVC[Weighing Service<br/>- Vehicle Processing<br/>- Weight Data]
        REPORT_SVC[Reporting Service<br/>- Report Generation<br/>- RBAC Enforcement]
        MASTER_SVC[Master Data Service<br/>- Vehicle Registry<br/>- Location Data]
    end

    subgraph "Data Layer"
        USER_DB[(User Database)]
        WEIGHT_DB[(Weight Database)]
        REPORT_DB[(Report Database)]
        MASTER_DB[(Master Database)]
    end

    subgraph "External Systems"
        KENHA[KENHA Systems]
        FACTORY[Factory Systems]
        HARDWARE[Weighbridge Hardware]
    end

    %% Client to Gateway
    WEB --> GATEWAY
    MOBILE --> GATEWAY
    API_CLIENT --> GATEWAY

    %% Gateway to Services
    GATEWAY --> USER_SVC
    GATEWAY --> WEIGHT_SVC
    GATEWAY --> REPORT_SVC
    GATEWAY --> MASTER_SVC

    %% Services to Databases
    USER_SVC --> USER_DB
    WEIGHT_SVC --> WEIGHT_DB
    REPORT_SVC --> REPORT_DB
    MASTER_SVC --> MASTER_DB

    %% External Integrations
    WEIGHT_SVC --> HARDWARE
    REPORT_SVC --> KENHA
    REPORT_SVC --> FACTORY

    %% Auth Flow Annotations
    GATEWAY -.->|"1. Validate JWT"| USER_SVC
    GATEWAY -.->|"2. Get User Permissions"| USER_SVC
    GATEWAY -.->|"3. Forward with Context"| REPORT_SVC
    REPORT_SVC -.->|"4. Check RBAC"| REPORT_SVC

    classDef gateway fill:#e1f5fe
    classDef service fill:#f3e5f5
    classDef database fill:#fff3e0
    classDef external fill:#e8f5e8
    classDef client fill:#fce4ec

    class GATEWAY gateway
    class USER_SVC,WEIGHT_SVC,REPORT_SVC,MASTER_SVC service
    class USER_DB,WEIGHT_DB,REPORT_DB,MASTER_DB database
    class KENHA,FACTORY,HARDWARE external
    class WEB,MOBILE,API_CLIENT client