    classDef masterdata fill:#9b59b6,stroke:#8e44ad,stroke-width:2px,color:#fff
    classDef database fill:#e74c3c,stroke:#c0392b,stroke-width:2px,color:#fff
    classDef queue fill:#f39c12,stroke:#e67e22,stroke-width:2px,color:#fff
    classDef external fill:#27ae60,stroke:#229954,stroke-width:2px,color:#fff
    
    class WEIGHT,TRANSACTION,COMPLIANCE,ANALYTICS,OPERATIONAL,SYNC,ARCHIVE service
